# Terminates TLS and splits the two audiences, which authenticate differently.
#
#   /v1/*   the emulator agents. Each carries its OWN per-client API key, so
#           this must pass Authorization through untouched and must NOT sit
#           behind the operator login.
#   /api/*  the operator UI. The browser holds no credential -- the key grants
#           a client's whole book of business and cannot be shipped to a
#           browser -- so Caddy injects it here, exactly as the Vite dev proxy
#           does locally. That makes this the seam where the UI is authorised,
#           and therefore the seam that has to be locked.
#   /       the static bundle.
#
# Without the basic_auth block below, anyone reaching this host would get an
# operator session, because the injected key is all /api/* asks for.

{$SITE_ADDRESS} {
	encode gzip

	# Agents: pass through, no injection, no operator login.
	handle /v1/* {
		reverse_proxy api:3000
	}

	# The operator UI. No basic_auth and no key injection any more: the app has
	# a real login form, and POST /api/session sets an HttpOnly signed cookie
	# that the API resolves to the same client the injected key stood for.
	#
	# The prompt this replaces could not be styled, could not say what was
	# wrong, and could not be logged out of without closing the browser. More
	# importantly, injecting the key here meant Caddy's basic_auth was the ONLY
	# thing standing in front of a credential that grants a client's entire book
	# of business -- lose that one line and every /api route was wide open.
	# Authorisation now lives in the API, next to the data it protects.
	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# A sheet is ~1.2MB and the default body limit is smaller than that.
	request_body {
		max_size 25MB
	}
}
