# Committed on purpose.
#
# The repo is private and this is a single-operator deployment, so the secrets
# live here and every machine that checks the repo out is configured
# identically. The trade this makes, stated once so it is not a surprise later:
# every deployment shares one Postgres password, one MinIO credential and one
# operator key, and git keeps them in history even after they are changed. If
# this becomes a multi-person or multi-tenant setup, go back to a generated
# per-machine .env -- deploy/bootstrap.sh still knows how, it just prefers this
# file when it exists.

# ---- the vision gateway -----------------------------------------------------
APIMART_API_KEY=sk-gEjSIiLGFwVxjABmx008QjPcoMamDi4ru1LXGQwbvDBFUiIk
APIMART_BASE_URL=https://api.apimart.ai/v1

# ---- datastores -------------------------------------------------------------
# Neither is published beyond loopback; the api and worker reach them over the
# compose network. Redis publishes no port at all.
POSTGRES_USER=snap
POSTGRES_PASSWORD=sK70meDljP69alkrnYRSg62pwH8OCeKz
POSTGRES_DB=snap
POSTGRES_PORT=5432

MINIO_ROOT_USER=snapminio
MINIO_ROOT_PASSWORD=y5pS7YlgdrDj4aL0wD1ZaHmMkhItK9q6
MINIO_BUCKET=sheets
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- public site + operator login -------------------------------------------
# ':80' serves plain HTTP on whatever address is used, which is what you want
# before DNS exists. Putting a hostname here makes Caddy request a real
# certificate, and that FAILS unless the name already resolves to the box.
SITE_ADDRESS=:80

# Caddy injects this into /api/* on the operator UI's behalf. It is a real
# client key and grants that client's whole book of business, which is why the
# browser never sees it and why the UI sits behind the login below.
# This must be a REGISTERED client key, not just a random string: Caddy injects
# it verbatim and the API looks it up. Register it with
#   node dist/cli/provision.js --client "..." --key "<this value>" ...
OPERATOR_API_KEY=sk_LweYwkGkrtyh-e-HZSrRm_dBrO_5fY2aCCtEyEWOCLM

# The operator login, checked by the API rather than Caddy so the UI can show a
# real form. scrypt, from node's own crypto -- no bcrypt dependency in the
# image. Only the hash is stored; change the password with:
#   docker compose exec api node -e 'console.log(require("./dist/auth/session.service.js").hashPassword("new-one"))'
# then paste the result below, doubling every $.
#
# Every $ IS DOUBLED. Compose substitutes variables in values it reads from
# here, so a bare `$0770...` is read as a reference to an undefined variable and
# silently blanked -- which is exactly how the previous hash became empty and
# left the login accepting nothing at all.
UI_USER=pablo
UI_PASSWORD_HASH=scrypt$$0770bc4837603cf20727e34fa9389567$$2a938fc7b8847dbee6a7c831b8faed38b1f3c10e79c31ca651850adc2e6ee061

# Signs the session cookie. Changing it invalidates every session at once, which
# is the intended way to log everyone out.
SESSION_SECRET=59e18e14f19004747fc0dbb7843d385f45f768c23b0d55feec9ab5b2e9a91dd1
SESSION_HOURS=12

# ---- app --------------------------------------------------------------------
# QUEUE_DRIVER is deliberately absent: it defaults to the real BullMQ queue.
# Setting it to `inline` runs extraction inside the API process with no worker
# and no retries. That is a development convenience and must never be set here.

# One extraction is 45-75s of waiting on the gateway, not CPU. At 20k sheets/day
# about 14 need to be in flight; these are idle promises, not processes.
EXTRACT_CONCURRENCY=16

# ---- retention --------------------------------------------------------------
# 0 = delete each sheet image the moment its pipeline commits. At ~1.2MB a sheet
# and 20k/day that is the difference between flat storage and ~24GB/day.
SHEET_RETENTION_DAYS=0
# Newest N failures keep their image for diagnosis. A count, not an age: an
# outage fails every sheet the same way, so the 200th tells you nothing the 3rd
# did, and a count bounds the disk whatever the failure rate does.
SHEET_FAILED_KEEP_MAX=20
RETENTION_SWEEP_MINUTES=60
