// Follow-target service schema.
//
// Two constraints carry the whole product and everything else is bookkeeping:
//
//   Person     @@unique([personalityId, handle])  -- a person exists ONCE per
//              personality, however many of that personality's accounts saw them.
//   Assignment @@unique([personId])               -- and is handed to exactly one
//              account, ever.
//
// Together they are the "don't follow the same person twice" rule, enforced by
// the database rather than by application logic, because three accounts
// uploading overlapping Quick Add lists concurrently is the normal case here,
// not an edge case. A race that slips past an application-level check would
// burn a follow slot silently.
//
// The uniqueness is scoped to the personality and NOT globally, deliberately.
// Two personalities following the same person is expected and must stay legal:
// they are separate personas with separate audiences, and a global unique on
// handle would make the second one silently unable to grow.
//
// Naming: `Personality` is what the business calls a "model" (e.g. "kris"). The
// word "model" is avoided in code because it means an LLM everywhere else in
// this repo, and `person.model` would be genuinely ambiguous.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The paying organisation. Owns personalities, filter rules and the budget.
model Client {
  id        String   @id @default(uuid())
  name      String
  apiKeyHash String  @unique
  createdAt DateTime @default(now())

  /// Which VLM to extract with. Per-client because the accuracy/cost trade-off
  /// is a commercial decision: see vlm_eval/ROUTING.md.
  extractionModel String @default("gemini-3.6-flash")
  /// Opt-in second avatar-only pass. Halves the women in the "man" bucket
  /// (2.1% -> 1.1%) for +$0.29/1000. Only worth it for country lists that the
  /// dry-run shows are contaminated.
  avatarPassEnabled Boolean @default(false)
  /// Hard stop. At $0.74/1000 profiles a looping uploader spends four figures
  /// in a day, so this is enforced from day one, not "later".
  monthlyBudgetUsd Decimal @default(100) @db.Decimal(10, 2)

  /// Targets handed to EACH of this client's accounts per day.
  ///
  /// One number for the whole client rather than a column on Account. What the
  /// cap protects against is Snapchat rate-limiting the account doing the
  /// following, and that threshold is a property of Snapchat and of how old the
  /// account is -- not of which account it happens to be. Twenty accounts each
  /// carrying their own copy of the same number meant twenty places to change
  /// when the answer moved, and nineteen chances to miss one.
  ///
  /// It is a PER-ACCOUNT cap, not a pool: each account gets this many, so
  /// adding an account adds throughput rather than dividing it.
  dailyCapPerAccount Int @default(240)

  /// Seconds a machine waits between follows, before its own jitter.
  ///
  /// Served to agents rather than acted on here -- this server hands out
  /// handles and never follows anything. It lives with the cap because the two
  /// are one decision: how hard to push an account. Changing it in the CRM
  /// beats editing a config file on every emulator box, which is what it
  /// replaces.
  followPaceSeconds Int @default(2)

  /// While this is in the future, an unauthenticated machine may POST /v1/enrol
  /// and be issued its own key. It is how a box is set up by typing only an
  /// address: the operator opens a short window in the CRM instead of copying a
  /// secret onto twenty machines by hand.
  ///
  /// A window, not a flag, because the failure mode of "enrolment left on" is
  /// that anyone who finds the domain can mint a key. It expires on its own.
  ///
  /// Superseded by enrolTokenHash for machines that can send one. Kept because
  /// an agent that predates the token has no field to put one in, and removing
  /// this would strand every already-deployed box.
  enrolOpenUntil DateTime?

  /// SHA-256 of the enrolment token, or null if this client has never minted
  /// one. A machine presenting the token may enrol whatever the window says.
  ///
  /// It is a BOOTSTRAP secret and never a working credential: /v1/enrol trades
  /// it for an ApiKey row belonging to that one machine. That is the whole
  /// point -- a shared key pasted onto twenty boxes cannot be revoked for one
  /// of them, which is the problem api_keys exists to solve.
  ///
  /// Unique so the lookup is by hash, like apiKeyHash. Hashed for the same
  /// reason too: a database dump must not hand anyone the ability to enrol.
  enrolTokenHash String? @unique

  personalities Personality[]
  filterRules   FilterRule[]
  apiKeys       ApiKey[]

  @@map("clients")
}

/// One credential. Many per client, so a machine can hold its own.
///
/// Client.apiKeyHash is the original single key and still works -- it is the
/// operator's, used by the CRM UI. This table is what enrolment writes to, so a
/// machine that is lost or rebuilt can be revoked on its own without changing
/// the key every other machine is using.
model ApiKey {
  id        String   @id @default(uuid())
  clientId  String
  /// What enrolled, for the operator to recognise it by: a hostname.
  name      String
  /// SHA-256, never the key. A database dump must not hand anyone the ability
  /// to drain a target queue.
  hash      String   @unique
  createdAt DateTime @default(now())
  lastSeenAt DateTime?
  /// Set rather than deleted, so a revoked machine still explains itself in the
  /// audit trail instead of vanishing.
  revokedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("api_keys")
}

/// A "model" in the business sense -- kris. THE DEDUPE SCOPE.
model Personality {
  id        String   @id @default(uuid())
  clientId  String
  name      String
  createdAt DateTime @default(now())

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accounts Account[]
  people   Person[]

  @@unique([clientId, name])
  @@map("personalities")
}

/// One Snapchat account belonging to a personality. Uploads sheets, receives
/// targets. A personality runs up to about ten of these.
model Account {
  id            String   @id @default(uuid())
  personalityId String
  label         String
  /// The cap that meters this account's handout is Client.dailyCapPerAccount.
  /// It used to live here, one copy per account, which made "how hard do we
  /// push" a setting you had to remember to apply in twenty places.
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())

  /// Context from a machine that registered itself: the display name shown next
  /// to the handle on the emulator's profile screen, and the hostname that read
  /// it. Both null for an account an operator typed in.
  ///
  /// Operator context only. The label is the identity -- these two exist so that
  /// "who is this account and which box is driving it" is answerable from the
  /// CRM, since an account created by POST /v1/personalities/:id/accounts was
  /// never named by a human.
  displayName   String?
  machine       String?

  personality Personality  @relation(fields: [personalityId], references: [id], onDelete: Cascade)
  sheets      Sheet[]
  assignments Assignment[]

  @@unique([personalityId, label])
  @@map("accounts")
}

enum SheetStatus {
  received
  extracting
  extracted
  /// Some rows came back malformed and were salvaged; the rest are usable.
  partial
  failed
  /// The extraction was rejected as untrustworthy -- see Extraction.distinctCuesRatio.
  rejected
}

model Sheet {
  id         String      @id @default(uuid())
  accountId  String
  /// Content hash. Re-uploading the same image is free and idempotent.
  sha256     String
  /// Where the image lives, or NULL once retention has deleted it.
  ///
  /// Nullable so that "the image is gone" is a fact the database states rather
  /// than one a caller discovers from a 404. The row itself is kept: it is one
  /// small row, it carries the cost and throughput numbers /api/stats is built
  /// from, and its (accountId, sha256) uniqueness is what makes a re-upload
  /// free. Only the ~1.2 MB of pixels goes. See retention.service.ts.
  storageKey String?
  width      Int?
  height     Int?
  status     SheetStatus @default(received)
  error      String?
  receivedAt DateTime    @default(now())

  account    Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  extraction Extraction?
  people     Person[]

  @@unique([accountId, sha256])
  @@index([status])
  /// Every /api/stats block that touches cost or throughput filters sheets by
  /// receivedAt over a window, optionally narrowed to one personality's
  /// accounts. Neither existing index can serve a date range: (accountId,
  /// sha256) sorts by a hash and (status) has no date in it at all.
  @@index([accountId, receivedAt])
  @@map("sheets")
}

/// One VLM call. The raw reply is kept verbatim so re-filtering and re-scoring
/// never cost another model call -- when a client edits their country list we
/// replay the filter over stored rows instead of re-paying for vision.
model Extraction {
  id               String   @id @default(uuid())
  sheetId          String   @unique
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  usd              Decimal  @default(0) @db.Decimal(10, 6)
  seconds          Float    @default(0)
  rawReply         Json
  profilesFound    Int      @default(0)
  /// distinct avatar descriptions / entries. A model that emits the same
  /// sentence for every face has stopped reading pixels and its labels are
  /// worthless however confident they look -- gpt-4.1-mini produced ONE
  /// description for 94 of 99 faces in testing. Low ratio => reject the sheet.
  distinctCuesRatio Float?
  createdAt        DateTime @default(now())

  sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@map("extractions")
}

enum Presents {
  man
  woman
  ambiguous
  not_a_person
  unknown
}

/// Where a handle came from: a contact-sheet screenshot, or someone typing it.
enum PersonSource {
  extraction
  manual
}

/// A discovered profile. Unique per personality -- this row IS the dedupe ledger.
model Person {
  id            String @id @default(uuid())
  personalityId String
  /// Normalised (casefolded, @-stripped) handle. The dedupe key.
  handle        String
  displayName   String

  /// How this handle reached the personality. Manual adds skip the filter --
  /// an operator naming a handle has already made the decision the filter
  /// exists to make, and a manual add carries no avatar or country for it to
  /// judge on anyway.
  source PersonSource @default(extraction)

  presentsAs       Presents @default(unknown)
  /// Judged from the avatar alone, with the name hidden.
  avatarPresentsAs Presents @default(unknown)
  /// Judged from the display name alone, with the avatar hidden. When these two
  /// disagree the profile is dropped rather than forwarded -- that disagreement
  /// caught a woman the combined judgement would have forwarded.
  namePresentsAs   Presents @default(unknown)

  nationality      String?
  nationalityConf  String?
  /// The drawn avatar's face colour, from the closed skin-tone vocabulary
  /// (see normalize.ts SKIN_TONES). Null when the model gave no usable answer.
  skinTone         String?
  avatarCues       String?

  /// The existing handle this one is a single character away from, with the
  /// same display name -- probably the same human, read differently once.
  ///
  /// Set at resolve time and kept, because it is the only place the verdict can
  /// live. It used to be carried by a `review` assignment row, where UNIQUE
  /// (personId) stopped a replay from queueing the twin; with review gone there
  /// is no row. `filter` reads this column and drops the person, so replaying
  /// filter+allocate after a rule change cannot queue both readings and follow
  /// one man twice. UNIQUE (personId) cannot catch that on its own -- they are
  /// two distinct Person rows, which is precisely the problem.
  nearDuplicateOf  String?

  firstSeenSheetId String?
  timesSeen        Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  personality    Personality @relation(fields: [personalityId], references: [id], onDelete: Cascade)
  firstSeenSheet Sheet?      @relation(fields: [firstSeenSheetId], references: [id], onDelete: SetNull)
  assignment     Assignment?
  overrides      Override[]

  @@unique([personalityId, handle])
  @@index([personalityId, presentsAs, nationality])
  /// /api/stats counts people by day, by country and by source, always over a
  /// createdAt window and usually for one personality. Scoped first because
  /// that is the query that has to stay cheap as the ledger grows; the
  /// unscoped rollup has to visit every personality anyway, and degrades to a
  /// full scan of this index rather than of the table.
  @@index([personalityId, createdAt])
  @@map("people")
}

/// Every state here descends from a forward. A person who did not match is
/// dropped and simply has no assignment row -- the ledger keeps them so a later
/// rule change can pick them up, but nothing is queued for a human to decide.
enum AssignmentState {
  /// Matched the filter, waiting for its account to ask for work.
  queued
  /// Given to the account; counts against today's cap.
  handed_out
  followed
  failed
  skipped
}

/// Which account is to follow this person. One per person, enforced by the
/// database, so two of kris's accounts can never both be told to follow @john.
/// Scoped through Person, so mia's account holding @john is unaffected.
model Assignment {
  id         String          @id @default(uuid())
  personId   String          @unique
  accountId  String
  state      AssignmentState @default(queued)
  reason     String?
  handedOutAt DateTime?
  resultAt   DateTime?
  note       String?
  createdAt  DateTime        @default(now())

  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, state])
  @@index([accountId, handedOutAt])
  /// /api/stats buckets assignments by state over a createdAt window. The
  /// (accountId, state) index above answers "how deep is this queue right
  /// now", which is a different question with no date in it.
  @@index([accountId, createdAt])
  @@map("assignments")
}

/// Ordered predicates. Evaluated in order; first match wins.
model FilterRule {
  id        String   @id @default(uuid())
  clientId  String
  position  Int
  enabled   Boolean  @default(true)
  /// Empty = any. Normally ["man"].
  presentsAs String[]
  /// Empty = any. Lowercased adjectives: ["italian","turkish"].
  countries  String[]
  /// Empty = any. Values from the closed skin-tone set: ["light","light-tan"].
  skinTones  String[]
  minConfidence String @default("medium")
  /// forward | reject. There is no third option: a person is sent out or
  /// dropped, never held.
  action    String   @default("forward")
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, position])
  @@map("filter_rules")
}

/// A human correction. Wins over model output, and doubles as labelled eval
/// data -- the balanced set vlm_eval/ROUTING.md says is needed before any
/// client contract quotes an accuracy number has to come from somewhere.
model Override {
  id        String   @id @default(uuid())
  personId  String
  field     String
  value     String
  userId    String?
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, field])
  @@map("overrides")
}
