// Follow-target service schema.
//
// Two constraints carry the whole product and everything else is bookkeeping:
//
//   Person     @@unique([personalityId, handle])  -- a person exists ONCE per
//              personality, however many of that personality's accounts saw them.
//   Assignment @@unique([personId])               -- and is handed to exactly one
//              account, ever.
//
// Together they are the "don't follow the same person twice" rule, enforced by
// the database rather than by application logic, because three accounts
// uploading overlapping Quick Add lists concurrently is the normal case here,
// not an edge case. A race that slips past an application-level check would
// burn a follow slot silently.
//
// The uniqueness is scoped to the personality and NOT globally, deliberately.
// Two personalities following the same person is expected and must stay legal:
// they are separate personas with separate audiences, and a global unique on
// handle would make the second one silently unable to grow.
//
// Naming: `Personality` is what the business calls a "model" (e.g. "kris"). The
// word "model" is avoided in code because it means an LLM everywhere else in
// this repo, and `person.model` would be genuinely ambiguous.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The paying organisation. Owns personalities, filter rules and the budget.
model Client {
  id        String   @id @default(uuid())
  name      String
  apiKeyHash String  @unique
  createdAt DateTime @default(now())

  /// Which VLM to extract with. Per-client because the accuracy/cost trade-off
  /// is a commercial decision: see vlm_eval/ROUTING.md.
  ///
  /// Selectable from the settings screen, and only from a closed list --
  /// src/extraction/models.ts. The value is handed to the gateway as the model
  /// name, so a string nothing recognises fails every extraction this client
  /// uploads rather than failing at the point it was typed.
  ///
  /// THE DEFAULT IS THE CHEAP MODEL AND IT IS NOT FREE. Scored against the keyed
  /// 99 in vlm_eval/FORMAT-AB.md, at the geometry the pipeline actually sends
  /// (99 entries in one image), gemini-3-flash-preview-nothinking forwards 3 of
  /// the 5 women in the sample to a men-only feed where gemini-3.6-flash
  /// forwards 1, for $0.0233 a sheet against $0.1282. Five women is the whole
  /// gender sample, so those are counts and not rates.
  ///
  /// The 2-of-5 arm exists but is not reachable from here: it needs the sheet
  /// banded into three images of 33, and PipelineService sends one image per
  /// sheet. Selecting the cheap model today buys the 3-of-5 row.
  ///
  /// It applies to NEW clients only. The migration that changed it deliberately
  /// leaves existing rows alone -- swapping a running client's model triples its
  /// leak count with no operator action and nothing in any log naming the
  /// migration as the cause, which is the same failure the session cap below is
  /// written at length about. An existing client changes it on the screen, where
  /// the numbers above are printed next to the field.
  extractionModel String @default("gemini-3-flash-preview-nothinking")
  /// Opt-in second avatar-only pass. Halves the women in the "man" bucket
  /// (2.1% -> 1.1%) for +$0.29/1000. Only worth it for country lists that the
  /// dry-run shows are contaminated.
  avatarPassEnabled Boolean @default(false)
  /// Hard stop. At $0.74/1000 profiles a looping uploader spends four figures
  /// in a day, so this is enforced from day one, not "later".
  monthlyBudgetUsd Decimal @default(100) @db.Decimal(10, 2)

  /// Targets handed to EACH of this client's accounts per day.
  ///
  /// One number for the whole client rather than a column on Account. What the
  /// cap protects against is Snapchat rate-limiting the account doing the
  /// following, and that threshold is a property of Snapchat and of how old the
  /// account is -- not of which account it happens to be. Twenty accounts each
  /// carrying their own copy of the same number meant twenty places to change
  /// when the answer moved, and nineteen chances to miss one.
  ///
  /// It is a PER-ACCOUNT cap, not a pool: each account gets this many, so
  /// adding an account adds throughput rather than dividing it.
  dailyCapPerAccount Int @default(240)

  /// Targets handed to EACH account inside any rolling sessionWindowMinutes.
  ///
  /// A second cap beside the daily one, and it exists because one account given
  /// a whole day's 240 in one run spends the tail of it against a cooldown that
  /// will not lift: a young Snapchat account stops accepting adds at roughly 40
  /// a day in testing, so every attempt after that is a spinner that never
  /// settles. The operator wants to work 40 on account A, rotate to B, then C,
  /// and come back to A -- and this is the number that makes the server refuse
  /// to hand A the 41st until it is due.
  ///
  /// A ROLLING WINDOW rather than a session, because a session is not a thing
  /// this server can observe: it has no idea when a machine starts or stops
  /// working an account, and inventing a session concept would mean trusting a
  /// machine to declare one. What it can observe is handedOutAt, so the rule is
  /// "no account is handed more than sessionCapPerAccount targets in any
  /// rolling sessionWindowMinutes". That degenerates to whatever is wanted: a
  /// window of 1440 makes it a second daily cap, 60 gives the rotation above.
  ///
  /// ENFORCED, not served, exactly like dailyCapPerAccount -- TargetsService
  /// .claim meters against both inside one transaction under one row lock, so a
  /// machine running an older build that has never heard of this still gets
  /// nothing once the window is full.
  ///
  /// Counted from handedOutAt, which means a `failed` report that requeues a row
  /// keeps the attempt counted against the window it was first handed in and
  /// never counts again. That matches the daily cap and is deliberate: the
  /// follow attempt was really made, and it is attempts Snapchat rate-limits.
  ///
  /// DEFAULTS TO 80, WHICH MEANS IT IS ON. It shipped at 2000 for one release
  /// -- the DTO's ceiling, a value that cannot bind at any daily cap of 1000 or
  /// less, chosen so that adding the column changed nothing for anyone -- and
  /// 80 is the operator's number. At 80 per rolling 60 minutes against a daily
  /// cap of 240 the cap binds: a claim is truncated while remainingToday is
  /// still healthy, three times a day, which is the rotation it is for.
  ///
  /// THAT TRUNCATION IS THE HAZARD, and it is why the previous default was off.
  /// An agent build older than the session cap reads "short batch, budget still
  /// on the clock" as proof the CRM has nobody left for it, and on that proof
  /// runs an irreversible pass hiding the people it was not handed from the
  /// emulator's Quick Add roster. Those are people this CRM approved and hands
  /// out in the next window, and they are gone from that device for good.
  ///
  /// So this default is safe ONLY against agents that read remainingInWindow,
  /// which is exactly what snapclient.contract_check verifies. Deploy order:
  /// agents first, then this. An operator who cannot confirm the fleet should
  /// set the cap back to 2000 on the settings screen, which turns it off again
  /// without a migration.
  sessionCapPerAccount Int @default(80)

  /// How long the window above is, in minutes.
  ///
  /// Never 0: a window of zero length counts nothing, so the cap beside it could
  /// never bind and would read as a setting while being off. The floor is 1.
  ///
  /// 60 is the rotation the operator described -- work one account, rotate to
  /// the next, come back when the window has rolled. A window is only ever half
  /// a setting, and the other half is no longer off: with the cap beside it at
  /// 80 this number is what decides how long an account waits, not just how the
  /// cap would be measured if anyone turned it on.
  sessionWindowMinutes Int @default(60)

  /// The two caps above, but for an account that is still ONBOARDING.
  ///
  /// An onboarding account is one that has not yet reached ONBOARD_TARGET
  /// searched adds (see OnboardingService). It is not doing the same work as an
  /// established one and must not be metered as if it were: it reaches people by
  /// typing exact usernames into search, which is a stronger signal to Snapchat
  /// than tapping a suggestion the app itself offered, and it is doing it on the
  /// youngest, least trusted account on the box. It also has the opposite
  /// pressure on it -- it cannot start earning until it is seeded -- so tying it
  /// to the fleet's ordinary cap forces one number to answer two questions.
  ///
  /// Enforced in TargetsService.claim exactly as the ordinary pair is: when the
  /// account is onboarding these REPLACE dailyCapPerAccount and
  /// sessionCapPerAccount, they do not stack with them. sessionWindowMinutes is
  /// shared, because the window is a property of the rotation rather than of the
  /// account's age.
  onboardingDailyCap Int @default(40)

  /// The most an onboarding account is handed inside sessionWindowMinutes.
  ///
  /// 10 by default and deliberately small: it is the number that decides how
  /// hard a brand-new account is pushed in its first hour, which is the hour it
  /// is most likely to be limited in.
  onboardingSessionCap Int @default(10)

  /// Seconds a machine waits between follows, before its own jitter.
  ///
  /// Served to agents rather than acted on here -- this server hands out
  /// handles and never follows anything. It lives with the cap because the two
  /// are one decision: how hard to push an account. Changing it in the CRM
  /// beats editing a config file on every emulator box, which is what it
  /// replaces.
  followPaceSeconds Int @default(2)

  /// While this is in the future, an unauthenticated machine may POST /v1/enrol
  /// and be issued its own key. It is how a box is set up by typing only an
  /// address: the operator opens a short window in the CRM instead of copying a
  /// secret onto twenty machines by hand.
  ///
  /// A window, not a flag, because the failure mode of "enrolment left on" is
  /// that anyone who finds the domain can mint a key. It expires on its own.
  ///
  /// Superseded by enrolTokenHash for machines that can send one. Kept because
  /// an agent that predates the token has no field to put one in, and removing
  /// this would strand every already-deployed box.
  enrolOpenUntil DateTime?

  /// SHA-256 of the enrolment token, or null if this client has never minted
  /// one. A machine presenting the token may enrol whatever the window says.
  ///
  /// It is a BOOTSTRAP secret and never a working credential: /v1/enrol trades
  /// it for an ApiKey row belonging to that one machine. That is the whole
  /// point -- a shared key pasted onto twenty boxes cannot be revoked for one
  /// of them, which is the problem api_keys exists to solve.
  ///
  /// Unique so the lookup is by hash, like apiKeyHash. Hashed for the same
  /// reason too: a database dump must not hand anyone the ability to enrol.
  enrolTokenHash String? @unique

  personalities Personality[]
  filterRules   FilterRule[]
  apiKeys       ApiKey[]
  onboarding    OnboardingHandle[]
  proxies       Proxy[]
  stock         StockAccount[]

  @@map("clients")
}

/// A proxy the operators bought for the emulator fleet.
///
/// STOCK, NOT WORKFLOW: nothing the software ever reads. No /v1 endpoint
/// serves this table, no claim or seed touches it, and no agent is told these
/// exist. It is the operators' own inventory -- the answer to "which proxy
/// does this emulator get" -- kept here instead of in a text file on someone's
/// desktop, because the CRM is the one place every operator already looks.
///
/// The credentials are stored readable, unlike every key in this schema,
/// because they exist to be typed into an emulator's proxy dialog by a human.
/// A hash cannot be typed. The exposure of a database dump is accepted: these
/// are bought-by-the-dozen proxies, not the client's book of business.
model Proxy {
  id       String @id @default(uuid())
  clientId String
  /// What the emulator's proxy dialog asks for first. http | https | socks4 |
  /// socks5, closed at the API, so a typo fails the paste and not the device.
  protocol String @default("http")
  host     String
  port     Int
  /// Empty string, not null, when the proxy is unauthenticated. The unique
  /// index below is what makes re-pasting a seller's list free, and Postgres
  /// treats NULLs as distinct -- a nullable column there would let the same
  /// credential-less proxy in twice.
  username String @default("")
  password String @default("")
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stock  StockAccount[]

  /// Same endpoint, same user = same proxy. Two rows may share host:port with
  /// different usernames -- sellers hand out one endpoint per credential.
  @@unique([clientId, host, port, username])
  @@map("proxies")
}

/// A Snapchat account the operators hold in stock, waiting to be installed on
/// an emulator.
///
/// NOT the Account model below. That is an account the software works: it
/// uploads sheets, is handed targets, is metered by the caps. A row here is a
/// credential pair the operators own and nothing more -- the software never
/// sees it, no /v1 endpoint serves it, and installing one on an emulator is a
/// human act. When that emulator's account starts working it is created as an
/// Account by the machine that drives it, and the two rows are never linked:
/// this one is the receipt for the credential, that one is the worker.
///
/// The password is readable for the same reason Proxy's is: it exists to be
/// typed into a login form on a device.
model StockAccount {
  id       String @id @default(uuid())
  clientId String
  username String
  password String

  /// Which proxy this account is to be configured behind, picked at import:
  /// random among this client's proxies with the fewest stock accounts, so
  /// the spread stays even without anyone doing arithmetic. SetNull on proxy
  /// delete -- the account outlives its proxy and shows as unassigned rather
  /// than vanishing with it.
  proxyId String?

  /// When the operator marked it installed on an emulator. A timestamp rather
  /// than a flag so "when did this one go live" stays answerable, and null is
  /// the honest state for an account still sitting in the drawer.
  deployedAt DateTime?
  createdAt  DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proxy  Proxy? @relation(fields: [proxyId], references: [id], onDelete: SetNull)

  /// Re-pasting a seller's file is how the list is topped up; it must not
  /// double it.
  @@unique([clientId, username])
  /// "how loaded is each proxy" -- the read the even-spread picker makes.
  @@index([proxyId])
  @@map("stock_accounts")
}

/// One credential. Many per client, so a machine can hold its own.
///
/// Client.apiKeyHash is the original single key and still works -- it is the
/// operator's, used by the CRM UI. This table is what enrolment writes to, so a
/// machine that is lost or rebuilt can be revoked on its own without changing
/// the key every other machine is using.
model ApiKey {
  id        String   @id @default(uuid())
  clientId  String
  /// What enrolled, for the operator to recognise it by: a hostname.
  name      String
  /// SHA-256, never the key. A database dump must not hand anyone the ability
  /// to drain a target queue.
  hash      String   @unique
  createdAt DateTime @default(now())
  lastSeenAt DateTime?
  /// Set rather than deleted, so a revoked machine still explains itself in the
  /// audit trail instead of vanishing.
  revokedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("api_keys")
}

/// A "model" in the business sense -- kris. THE DEDUPE SCOPE.
model Personality {
  id        String   @id @default(uuid())
  clientId  String
  name      String
  createdAt DateTime @default(now())

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accounts Account[]
  people   Person[]

  @@unique([clientId, name])
  @@map("personalities")
}

/// One Snapchat account belonging to a personality. Uploads sheets, receives
/// targets. A personality runs up to about ten of these.
model Account {
  id            String   @id @default(uuid())
  personalityId String
  label         String
  /// The cap that meters this account's handout is Client.dailyCapPerAccount.
  /// It used to live here, one copy per account, which made "how hard do we
  /// push" a setting you had to remember to apply in twenty places.
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())

  /// Context from a machine that registered itself: the display name shown next
  /// to the handle on the emulator's profile screen, and the hostname that read
  /// it. Both null for an account an operator typed in.
  ///
  /// Operator context only. The label is the identity -- these two exist so that
  /// "who is this account and which box is driving it" is answerable from the
  /// CRM, since an account created by POST /v1/personalities/:id/accounts was
  /// never named by a human.
  displayName   String?
  machine       String?

  /// How many people this account has added BY SEARCH, which is how a new
  /// account is seeded when Snapchat suggests it nobody. It decides whether the
  /// account still needs onboarding, and it is a count rather than a flag so
  /// that "half way through" is a state the console can show rather than infer.
  onboardedCount Int @default(0)

  /// Where this account is in its life, and therefore what the agent does with
  /// it when the rotation arrives. A LADDER: every rung is passed once, in
  /// order, and nothing ever moves back down it.
  ///
  ///   cleanup_contacts  a bought account still carrying the last owner's
  ///                     world. Contact sync goes first, because until it is
  ///                     off Snapchat keeps re-suggesting the very people the
  ///                     next two rungs are about to delete.
  ///   cleanup_chats     conversations, cleared while the friend list is still
  ///                     intact and there is therefore something to find them
  ///                     by.
  ///   cleanup_friends   the friend list itself, last because it is the
  ///                     irreversible half.
  ///   seeding           wiped, and being given people to add BY SEARCH because
  ///                     Snapchat suggests a fresh account nobody.
  ///                     onboardedCount counts the progress; ONBOARD_TARGET
  ///                     ends it.
  ///   established       Quick Add has a roster of its own, so the walk works.
  ///
  /// NOTHING IS HANDED OUT BELOW `seeding`. Every cleanup rung refuses, because
  /// a cap slot spent on a roster that is about to be deleted buys nothing.
  ///
  /// Three cleanup rungs rather than one flag because the wipe is the slowest
  /// thing that happens to an account and an operator watching it needs to tell
  /// a stuck one from a slow one. It is separate from onboardedCount for the
  /// same reason it always was: "has this account been wiped" is not something
  /// a count of adds can answer.
  ///
  /// EXISTING ACCOUNTS ARE PUT PAST CLEANUP BY THE MIGRATION, never on a
  /// cleanup rung: an account that has been running a fortnight, handed
  /// `cleanup_contacts`, would be told to delete the friends it spent that
  /// fortnight earning.
  phase        AccountPhase @default(cleanup_contacts)
  /// When the WHOLE wipe was reported done -- stamped on arrival at `seeding`,
  /// not on each rung. Null while it has not been, which is what makes a
  /// half-finished cleanup visible instead of merely absent; which rung it
  /// stalled on is `phase` itself.
  cleanedAt    DateTime?

  personality Personality  @relation(fields: [personalityId], references: [id], onDelete: Cascade)
  sheets      Sheet[]
  assignments Assignment[]
  hides       Hide[]
  onboarding  OnboardingHandle[]

  @@unique([personalityId, label])
  @@map("accounts")
}

/// Handles to seed a brand-new account with.
///
/// A fresh Snapchat account has no Quick Add suggestions at all, so the walk has
/// nothing to walk and the ledger has nobody to offer it. It is onboarded by
/// searching people by name instead, which means it needs a list of names -- and
/// these are pasted in by the operator, not read off a contact sheet.
///
/// NOT a Person row, deliberately. Every row in that table carries what the
/// vision model read -- display name, what the avatar presents as, nationality,
/// confidence -- and filter() drops a row whose signals are missing, so an
/// import would be swallowed the moment it arrived. This is a pool to draw
/// from; a person becomes a Person when an account is actually given them.
model OnboardingHandle {
  id              String    @id @default(uuid())
  clientId        String
  handle          String
  /// Which account spent it, and when. Kept rather than deleted so the same
  /// person is never handed to a second account of the same client.
  usedByAccountId String?
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  client Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: deleting an account must not delete the record that
  /// its handle was already spent.
  account Account? @relation(fields: [usedByAccountId], references: [id], onDelete: SetNull)

  /// Re-importing the same file is how an operator tops the list up, and it
  /// must not double it.
  @@unique([clientId, handle])
  /// "what is left to hand out" -- the only read the onboarding claim makes.
  @@index([clientId, usedAt])
  @@map("onboarding_handles")
}

/// One person this account has swiped off its own Quick Add roster.
///
/// The other half of a cycle's work, and until now the half the server never
/// saw. An agent is told two things -- follow these, and these are refused --
/// and it reported only the follows, so a fleet of twenty boxes could be hiding
/// thousands of rows a day with no record that any of it happened. "Did that
/// machine do its pass" was answerable only by watching its screen.
///
/// A separate table rather than a state on Assignment, because the population
/// has no assignment TO this account by definition: refusedHandles is exactly
/// the people whose Assignment is null or points at a sibling account, and
/// Assignment.personId is UNIQUE. Writing a hide there would either fail or
/// steal a person from the account that is going to follow them.
///
/// (accountId, personId) unique and upserted, so a re-hide -- a row Snapchat
/// served again after the roster re-rolled, which is normal -- moves `at` and
/// counts once. Bumping `times` says how often we have had to hide the same
/// face, which is the signal that a roster is going stale.
model Hide {
  id        String   @id @default(uuid())
  accountId String
  personId  String
  times     Int      @default(1)
  at        DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([accountId, personId])
  /// "What has this box hidden today" -- the per-account, time-windowed read
  /// that /api/stats and any fleet dashboard asks.
  @@index([accountId, at])
  @@map("hides")
}

enum SheetStatus {
  received
  extracting
  extracted
  /// Some rows came back malformed and were salvaged; the rest are usable.
  partial
  failed
  /// The extraction was rejected as untrustworthy -- see Extraction.distinctCuesRatio.
  rejected
}

model Sheet {
  id         String      @id @default(uuid())
  accountId  String
  /// Content hash. Re-uploading the same image is free and idempotent.
  sha256     String
  /// Where the image lives, or NULL once retention has deleted it.
  ///
  /// Nullable so that "the image is gone" is a fact the database states rather
  /// than one a caller discovers from a 404. The row itself is kept: it is one
  /// small row, it carries the cost and throughput numbers /api/stats is built
  /// from, and its (accountId, sha256) uniqueness is what makes a re-upload
  /// free. Only the ~1.2 MB of pixels goes. See retention.service.ts.
  storageKey String?
  width      Int?
  height     Int?
  status     SheetStatus @default(received)
  error      String?
  receivedAt DateTime    @default(now())

  account    Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  extraction Extraction?
  people     Person[]

  @@unique([accountId, sha256])
  @@index([status])
  /// Every /api/stats block that touches cost or throughput filters sheets by
  /// receivedAt over a window, optionally narrowed to one personality's
  /// accounts. Neither existing index can serve a date range: (accountId,
  /// sha256) sorts by a hash and (status) has no date in it at all.
  @@index([accountId, receivedAt])
  @@map("sheets")
}

/// One VLM call. The raw reply is kept verbatim so re-filtering and re-scoring
/// never cost another model call -- when a client edits their country list we
/// replay the filter over stored rows instead of re-paying for vision.
model Extraction {
  id               String   @id @default(uuid())
  sheetId          String   @unique
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  usd              Decimal  @default(0) @db.Decimal(10, 6)
  seconds          Float    @default(0)
  rawReply         Json
  profilesFound    Int      @default(0)
  /// distinct avatar descriptions / entries. A model that emits the same
  /// sentence for every face has stopped reading pixels and its labels are
  /// worthless however confident they look -- gpt-4.1-mini produced ONE
  /// description for 94 of 99 faces in testing. Low ratio => reject the sheet.
  distinctCuesRatio Float?
  createdAt        DateTime @default(now())

  sheet Sheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@map("extractions")
}

enum Presents {
  man
  woman
  ambiguous
  not_a_person
  unknown
}

/// Where a handle came from: a contact-sheet screenshot, or someone typing it.
enum PersonSource {
  extraction
  manual
}

/// A discovered profile. Unique per personality -- this row IS the dedupe ledger.
model Person {
  id            String @id @default(uuid())
  personalityId String
  /// Normalised (casefolded, @-stripped) handle. The dedupe key.
  handle        String
  displayName   String

  /// How this handle reached the personality. Manual adds skip the filter --
  /// an operator naming a handle has already made the decision the filter
  /// exists to make, and a manual add carries no avatar or country for it to
  /// judge on anyway.
  source PersonSource @default(extraction)

  presentsAs       Presents @default(unknown)
  /// Judged from the avatar alone, with the name hidden.
  avatarPresentsAs Presents @default(unknown)
  /// Judged from the display name alone, with the avatar hidden. When these two
  /// disagree the profile is dropped rather than forwarded -- that disagreement
  /// caught a woman the combined judgement would have forwarded.
  namePresentsAs   Presents @default(unknown)

  nationality      String?
  nationalityConf  String?
  /// The drawn avatar's face colour, from the closed skin-tone vocabulary
  /// (see normalize.ts SKIN_TONES). Null when the model gave no usable answer.
  skinTone         String?
  avatarCues       String?

  /// The existing handle this one is a single character away from, with the
  /// same display name -- probably the same human, read differently once.
  ///
  /// Set at resolve time and kept, because it is the only place the verdict can
  /// live. It used to be carried by a `review` assignment row, where UNIQUE
  /// (personId) stopped a replay from queueing the twin; with review gone there
  /// is no row. `filter` reads this column and drops the person, so replaying
  /// filter+allocate after a rule change cannot queue both readings and follow
  /// one man twice. UNIQUE (personId) cannot catch that on its own -- they are
  /// two distinct Person rows, which is precisely the problem.
  nearDuplicateOf  String?

  firstSeenSheetId String?
  timesSeen        Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  personality    Personality @relation(fields: [personalityId], references: [id], onDelete: Cascade)
  firstSeenSheet Sheet?      @relation(fields: [firstSeenSheetId], references: [id], onDelete: SetNull)
  assignment     Assignment?
  overrides      Override[]
  hides          Hide[]

  @@unique([personalityId, handle])
  @@index([personalityId, presentsAs, nationality])
  /// /api/stats counts people by day, by country and by source, always over a
  /// createdAt window and usually for one personality. Scoped first because
  /// that is the query that has to stay cheap as the ledger grows; the
  /// unscoped rollup has to visit every personality anyway, and degrades to a
  /// full scan of this index rather than of the table.
  @@index([personalityId, createdAt])
  @@map("people")
}

/// The lives of an account, in order -- and the order is load-bearing, not
/// documentation: the server compares rungs to decide whether a report may
/// advance an account, so a value inserted in the wrong place here silently
/// changes what "forwards" means. See Account.phase and PHASES in
/// onboarding.service.ts, which restates this order in TypeScript.
enum AccountPhase {
  cleanup_contacts
  cleanup_chats
  cleanup_friends
  seeding
  established
}

/// Every state here descends from a forward. A person who did not match is
/// dropped and simply has no assignment row -- the ledger keeps them so a later
/// rule change can pick them up, but nothing is queued for a human to decide.
enum AssignmentState {
  /// Matched the filter, waiting for its account to ask for work.
  queued
  /// Given to the account; counts against today's cap.
  handed_out
  followed
  failed
  skipped
}

/// Which account is to follow this person. One per person, enforced by the
/// database, so two of kris's accounts can never both be told to follow @john.
/// Scoped through Person, so mia's account holding @john is unaffected.
model Assignment {
  id         String          @id @default(uuid())
  personId   String          @unique
  accountId  String
  state      AssignmentState @default(queued)
  reason     String?
  handedOutAt DateTime?
  resultAt   DateTime?
  note       String?
  createdAt  DateTime        @default(now())

  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, state])
  @@index([accountId, handedOutAt])
  /// /api/stats buckets assignments by state over a createdAt window. The
  /// (accountId, state) index above answers "how deep is this queue right
  /// now", which is a different question with no date in it.
  @@index([accountId, createdAt])
  @@map("assignments")
}

/// Ordered predicates. Evaluated in order; first match wins.
model FilterRule {
  id        String   @id @default(uuid())
  clientId  String
  position  Int
  enabled   Boolean  @default(true)
  /// Empty = any. Normally ["man"].
  presentsAs String[]
  /// Empty = any. Lowercased adjectives: ["italian","turkish"].
  countries  String[]
  /// Empty = any. Values from the closed skin-tone set: ["light","light-tan"].
  skinTones  String[]
  minConfidence String @default("medium")
  /// forward | reject. There is no third option: a person is sent out or
  /// dropped, never held.
  action    String   @default("forward")
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, position])
  @@map("filter_rules")
}

/// A human correction. Wins over model output, and doubles as labelled eval
/// data -- the balanced set vlm_eval/ROUTING.md says is needed before any
/// client contract quotes an accuracy number has to come from somewhere.
model Override {
  id        String   @id @default(uuid())
  personId  String
  field     String
  value     String
  userId    String?
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, field])
  @@map("overrides")
}
