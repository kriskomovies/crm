# Copy to .env and fill in. .env is gitignored; this file is not.

# ---- the one secret that matters -------------------------------------------
# ROTATE THE OLD KEY. The key used during benchmarking was pasted into a chat
# transcript and must be considered public: https://apimart.ai/keys
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai/v1

# ---- datastores -------------------------------------------------------------
POSTGRES_USER=snap
POSTGRES_PASSWORD=change-me
POSTGRES_DB=snap
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=sheets
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- public site + operator login -------------------------------------------
# Caddy is the only published service and issues TLS for this name, so it must
# resolve to this box before `docker compose up` or issuance fails.
SITE_ADDRESS=targets.example.com

# The key Caddy injects into /api/* on the operator UI's behalf. It is a real
# per-client key and grants that client's whole book of business, which is why
# the browser never sees it and why the UI sits behind the login below.
OPERATOR_API_KEY=

# Generate the hash with:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
UI_USER=operator
UI_PASSWORD_HASH=

# ---- app --------------------------------------------------------------------
# QUEUE_DRIVER is deliberately absent: it defaults to the real BullMQ queue.
# Setting it to `inline` runs extraction inside the API process with no worker
# and no retries. That is a development convenience and must never be set here.

# One extraction is 45-75s of waiting on the gateway, not CPU. At 20k sheets/day
# about 14 need to be in flight; these are idle promises, not processes.
EXTRACT_CONCURRENCY=16

# ---- retention --------------------------------------------------------------
# THIS IS THE SETTING THAT DECIDES WHETHER THE DISK FILLS. A sheet is ~1.2 MB
# and the design target is 20,000 a day: ~24 GB/day and ~8.8 TB/year if images
# are never removed.
#
#   0    delete as soon as the pipeline completes  (default -- storage stays
#        flat at roughly the number of sheets in flight)
#   N    keep N days, then sweep
#   <0   keep forever
#
# 0 is the default because the image is read exactly ONCE, by the extraction
# call. Nothing reads it afterwards: there is no CRM screen that displays it,
# and replaying filter/allocate after a rule change reads Extraction.rawReply,
# not the pixels. Raise it only if you add a path that re-reads images -- a
# re-extraction after a prompt fix is the obvious one.
SHEET_RETENTION_DAYS=0

# Failed and rejected sheets are the only ones anyone looks at: a garbled sheet
# cannot be blamed on the capture or the model without the image. But failure
# has no completion event to delete on -- that is what failure means.
#
# So this is a COUNT, not an age: keep the newest N images, drop the rest. It
# bounds the disk at N x ~1.2 MB whatever the failure rate does. An age bound is
# unbounded in exactly the case that matters -- a gateway outage failing every
# sheet for a day writes 20,000 images that an age rule then holds for its whole
# window.
#
# 20 is a diagnostic sample, not an archive. Failures arrive correlated: at the
# 20,000/day target an ordinary 1% failure rate is already 200 a day, and an
# outage fails every sheet the same way, so the 200th image tells you nothing
# the 3rd did not. ~24 MB. Negative keeps them all.
SHEET_FAILED_KEEP_MAX=20

# The sweep is the safety net, not the mechanism: it catches sheets whose
# immediate delete was interrupted, and failures that have aged out.
RETENTION_SWEEP_MINUTES=60
